{
  "name": "defi-governance-alpha-bot",
  "version": "1.0.0",
  "description": "Governance-event-driven DeFi trading system",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "better-sqlite3": "^11.7.0",
    "zod": "^3.24.0",
    "eventemitter3": "^5.0.1",
    "graphql-request": "^7.1.0",
    "graphql": "^16.10.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.0"
  }
}
