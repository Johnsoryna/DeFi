# ============================================================
# DeFi Governance Alpha Bot — Environment Configuration
# Copy to .env and fill in values
# ============================================================

# --- RPC Endpoints (free tier) ---
# Primary: Alchemy (free key at https://dashboard.alchemy.com)
ALCHEMY_API_KEY=
# Fallback RPCs (no key needed)
PUBLICNODE_HTTP=https://ethereum-rpc.publicnode.com
PUBLICNODE_WSS=wss://ethereum-rpc.publicnode.com
CLOUDFLARE_HTTP=https://cloudflare-eth.com

# --- MEV Protection RPCs (no key needed) ---
FLASHBOTS_RPC=https://rpc.flashbots.net/fast
MEV_BLOCKER_RPC=https://rpc.mevblocker.io

# --- Wallet ---
# dYdX v4 wallet mnemonic (Cosmos SDK)
DYDX_MNEMONIC=
# Ethereum private key (0x-prefixed) for on-chain txs
ETH_PRIVATE_KEY=

# --- API Keys (free tier) ---
ETHERSCAN_API_KEY=
TALLY_API_KEY=
THE_GRAPH_API_KEY=

# --- Alerting ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Operational ---
LOG_LEVEL=info
POLLING_INTERVAL_MS=12000
SNAPSHOT_POLL_INTERVAL_MS=60000
FORUM_POLL_INTERVAL_MS=300000
DB_PATH=./data/governance.db
