# ============================================================
# DeFi Governance Alpha Bot — Environment Configuration
# Copy to .env and fill in values
# ============================================================

# --- RPC Endpoints (free tier) ---
# Primary: Alchemy (free key at https://dashboard.alchemy.com)
# Free tier: 30M CU/month, 500 CU/sec per app
ALCHEMY_API_KEY=
# Optional direct Alchemy URLs (shared with Foundry tooling if you use contracts/foundry.toml)
ALCHEMY_RPC_URL=
ALCHEMY_WSS_URL=
# Fallback RPCs (no key needed)
PUBLICNODE_HTTP=https://ethereum-rpc.publicnode.com
PUBLICNODE_WSS=wss://ethereum-rpc.publicnode.com
CLOUDFLARE_HTTP=https://cloudflare-eth.com

# --- MEV Protection RPCs (no key needed) ---
FLASHBOTS_RPC=https://rpc.flashbots.net/fast
# MEV Blocker: now owned by Special Mechanisms Group (acquired from CoW Protocol consortium)
# Returns 90% of backrun auction profits to users
MEV_BLOCKER_RPC=https://rpc.mevblocker.io

# --- Binance Futures ---
# Create API Key at https://www.binance.com/en/my/settings/api-management
# Enable "Futures" permission, restrict to your server IP for security.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Set to "true" to use Binance Futures Demo Trading (demo-fapi.binance.com)
BINANCE_TESTNET=false

# Optional: EVM private key for on-chain read/write wallet flows (must be 0x + 64 hex chars)
ETH_PRIVATE_KEY=

# --- API Keys (free tier) ---
# Etherscan: free tier = 3 calls/sec (reduced from 5 in 2026), 100k calls/day
ETHERSCAN_API_KEY=
THE_GRAPH_API_KEY=

# --- Alerting ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Operational ---
LOG_LEVEL=info
# 60s default keeps RPC usage within free tier limits.
# Alchemy free tier = 30M CU/month (last-resort fallback only).
# PublicNode + Cloudflare handle primary traffic (unlimited, free).
# Decrease to 12000 for faster monitoring if on a paid RPC plan.
POLLING_INTERVAL_MS=60000
SNAPSHOT_POLL_INTERVAL_MS=60000
FORUM_POLL_INTERVAL_MS=300000
# Comma-separated protocol IDs for on-chain trade enablement (default empty = disabled).
# Example: ONCHAIN_TRADE_ENABLED_PROTOCOLS=arbitrum
ONCHAIN_TRADE_ENABLED_PROTOCOLS=
# Optional monitors/features (default disabled to keep baseline lightweight)
ENABLE_WHALE_TRACKER=false
ENABLE_DEPENDENCY_GRAPH=false
DB_PATH=./data/governance.db

# --- Safety ---
# DRY_RUN=true (default): Orders are logged but NOT sent to exchanges.
# Set to "false" to enable LIVE TRADING (real money!).
DRY_RUN=true

# Initial portfolio value in USD (used when Binance balance unavailable)
INITIAL_PORTFOLIO_USD=10000
